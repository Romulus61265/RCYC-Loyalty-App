# Only EXPO_PUBLIC_* variables are embedded in the mobile bundle.
# NEVER place service-role keys, partner API secrets or AI provider keys here —
# those live exclusively in Supabase Edge Function secrets / enterprise vaults.

# mock | supabase | enterprise
EXPO_PUBLIC_SERVICE_MODE=mock
EXPO_PUBLIC_APP_ENV=development

# Public (anon) Supabase values — safe for client use, protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the backend-for-frontend (Edge Functions / API gateway).
EXPO_PUBLIC_API_BASE_URL=

# debug | info | warn | error  (defaults: debug in development, warn in production)
EXPO_PUBLIC_LOG_LEVEL=

# Mock mode only: pin "now" to show a journey phase (ISO date-time).
# Leave empty to use the dataset reference moment (11 May 2027, 09:00 Miami).
EXPO_PUBLIC_DEMO_NOW=

# Mock mode only: default | empty | slow | error | partial-error
# (on web you can also append ?scenario=empty or ?now=2027-05-20T10:00:00+02:00 to the URL)
EXPO_PUBLIC_MOCK_SCENARIO=
